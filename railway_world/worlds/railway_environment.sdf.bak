<?xml version="1.0"?>
<sdf version="1.9">
  <world name="railway_environment">
    <physics name="default_physics" type="ignored"><max_step_size>0.002</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <!-- Synthetic Korean GNSS origin for PX4 NavSat. Replace with surveyed
         coordinates when converting this reference world to a site twin. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>37.5665</latitude_deg>
      <longitude_deg>126.9780</longitude_deg>
      <elevation>38.0</elevation>
    </spherical_coordinates>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Required by PX4 SITL vehicles spawned into this custom world. -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <scene><ambient>0.55 0.58 0.62 1</ambient><background>0.68 0.80 0.92 1</background><shadows>true</shadows><grid>false</grid></scene>
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>Railway World</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine><scene>scene</scene>
        <ambient_light>0.55 0.58 0.62</ambient_light><background_color>0.68 0.80 0.92</background_color>
        <!-- Opens looking at the X500 default spawn on the station track. -->
        <camera_pose>-125 -10 6 0 0.28 0.96</camera_pose>
        <camera_clip><near>0.10</near><far>2000</far></camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="Interactive view control"/>
      <plugin filename="CameraTracking" name="Camera Tracking"/>
      <plugin filename="WorldControl" name="World control"/>
      <plugin filename="WorldStats" name="World stats"/>
    </gui>
    <light name="sun" type="directional"><pose>0 0 80 0 0 0</pose><cast_shadows>true</cast_shadows><intensity>1.1</intensity><direction>-0.45 0.25 -0.86</direction><diffuse>0.96 0.94 0.88 1</diffuse><specular>0.25 0.25 0.25 1</specular></light>

