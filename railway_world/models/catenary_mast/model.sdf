<?xml version="1.0"?>
<sdf version="1.9">
  <model name="catenary_mast">
    <static>true</static>
    <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>30</label></plugin>
    <link name="mast">
      <collision name="foundation_collision"><pose>0 3.20 0.35 0 0 0</pose><geometry><box><size>0.85 0.85 0.70</size></box></geometry></collision>
      <visual name="foundation"><pose>0 3.20 0.35 0 0 0</pose><geometry><box><size>0.85 0.85 0.70</size></box></geometry><material><ambient>0.40 0.40 0.38 1</ambient><diffuse>0.58 0.58 0.55 1</diffuse></material></visual>

      <!-- H-section galvanised steel mast -->
      <visual name="mast_web"><pose>0 3.20 4.05 0 0 0</pose><geometry><box><size>0.055 0.19 7.40</size></box></geometry><material><ambient>0.35 0.37 0.36 1</ambient><diffuse>0.55 0.58 0.56 1</diffuse><specular>0.35 0.35 0.35 1</specular></material></visual>
      <visual name="mast_flange_a"><pose>0.12 3.20 4.05 0 0 0</pose><geometry><box><size>0.055 0.31 7.40</size></box></geometry><material><diffuse>0.53 0.56 0.54 1</diffuse></material></visual>
      <visual name="mast_flange_b"><pose>-0.12 3.20 4.05 0 0 0</pose><geometry><box><size>0.055 0.31 7.40</size></box></geometry><material><diffuse>0.53 0.56 0.54 1</diffuse></material></visual>

      <!-- Cantilever and registration assembly -->
      <visual name="upper_arm"><pose>0 1.70 7.12 0 0 0</pose><geometry><box><size>0.085 3.0 0.085</size></box></geometry><material><diffuse>0.48 0.51 0.49 1</diffuse></material></visual>
      <visual name="diagonal_arm"><pose>0 1.72 6.45 -0.43 0 0</pose><geometry><cylinder><radius>0.038</radius><length>3.28</length></cylinder></geometry><material><diffuse>0.46 0.49 0.47 1</diffuse></material></visual>
      <visual name="upper_insulator"><pose>0 2.65 7.12 1.570796 0 0</pose><geometry><cylinder><radius>0.105</radius><length>0.62</length></cylinder></geometry><material><diffuse>0.23 0.37 0.22 1</diffuse><specular>0.45 0.45 0.45 1</specular></material></visual>
      <visual name="lower_insulator"><pose>0 2.70 6.84 1.570796 0 0</pose><geometry><cylinder><radius>0.090</radius><length>0.52</length></cylinder></geometry><material><diffuse>0.23 0.37 0.22 1</diffuse><specular>0.45 0.45 0.45 1</specular></material></visual>
      <visual name="steady_arm"><pose>0 0.64 5.97 1.12 0 0</pose><geometry><cylinder><radius>0.028</radius><length>1.45</length></cylinder></geometry><material><diffuse>0.46 0.49 0.47 1</diffuse></material></visual>

      <!-- Feeder support and safety marker -->
      <visual name="feeder_bracket"><pose>0 3.85 7.18 1.570796 0 0</pose><geometry><cylinder><radius>0.040</radius><length>1.30</length></cylinder></geometry><material><diffuse>0.47 0.50 0.48 1</diffuse></material></visual>
      <visual name="feeder_insulator"><pose>0 4.15 7.18 1.570796 0 0</pose><geometry><cylinder><radius>0.095</radius><length>0.42</length></cylinder></geometry><material><diffuse>0.31 0.42 0.27 1</diffuse></material></visual>
      <visual name="warning_plate"><pose>-0.151 3.20 2.65 0 1.570796 0</pose><geometry><box><size>0.36 0.018 0.24</size></box></geometry><material><ambient>0.75 0.58 0.04 1</ambient><diffuse>0.92 0.72 0.06 1</diffuse></material></visual>
    </link>
  </model>
</sdf>
